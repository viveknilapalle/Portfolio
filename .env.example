# Canonical site URL used for metadata, sitemap and Open Graph.
# Falls back to "siteUrl" in content/profile.json when unset.
NEXT_PUBLIC_SITE_URL=https://viveknilapalle.vercel.app

# Optional. A read-only GitHub token raises the API rate limit (60 → 5,000 req/h).
# The site works without it; GitHub data is simply skipped if requests fail.
GITHUB_TOKEN=
